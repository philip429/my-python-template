import pandas as pd
import pytest
import statsmodels.formula.api as smf
from sklearn.linear_model import LinearRegression

from {{ project_name }}.dataExploration.model_validation import (
    models_results,
    plot_model_predictions,
)


def test_predictions_use_custom_names_and_exclude_target():
    frame = pd.DataFrame({"x": [1, 2, 3], "target": [2, 4, 6]}, index=[5, 6, 7])
    model = LinearRegression().fit(frame[["x"]], frame["target"])
    result = models_results(frame, [model], "target", ["baseline"])
    assert result.columns.tolist() == ["target", "baseline"]
    assert result["baseline"].tolist() == pytest.approx([2, 4, 6])
    assert result.index.equals(frame.index)
    grid = plot_model_predictions(result, actual_value_col="target")
    assert list(grid.axes_dict) == ["baseline"]


def test_prediction_series_are_assigned_in_row_order():
    class Model:
        def predict(self, data):
            return pd.Series([10, 20])

    frame = pd.DataFrame({"x": [1, 2], "actual_value": [10, 20]}, index=[8, 9])
    result = models_results(frame, [Model()], "actual_value")
    assert result["model_1"].tolist() == [10, 20]


@pytest.mark.parametrize("names", [[], ["target"], ["a", "b"]])
def test_invalid_model_names_raise(names):
    with pytest.raises(ValueError, match="model|Model"):
        models_results(pd.DataFrame({"target": [1]}), [object()], "target", names)


def test_formula_model_predictions():
    frame = pd.DataFrame({"x": [1.0, 2.0, 3.0, 4.0], "target": [2.0, 4.0, 6.0, 8.0]})
    model = smf.ols("target ~ x", data=frame).fit()
    result = models_results(frame, [model], "target")
    assert result["model_1"].tolist() == pytest.approx(frame["target"].tolist())
