[project]
name = "{{ project_name | replace('_', '-') }}"
version = "0.1.0"
description = {{ project_description | to_json(ensure_ascii=False) }}
readme = "README.md"
requires-python = ">={{ python_version }}, <{{ python_version.split('.')[0] }}.{{ (python_version.split('.')[1] | int) + 1 }}"
authors = [{ name = {{ author_name | to_json(ensure_ascii=False) }} }]
dependencies = [
    "ipykernel>=7.4.0",
    "jupyterlab>=4.6.1",
    "matplotlib>=3.11.0",
    "missingno>=0.5.2",
    "numpy>=2.5.3",
    # UpSetPlot 0.9 uses chained inplace updates that fail with pandas 3.
    "pandas>=2.2.3,<3",
    # Tested pandas-2-compatible pair; newer releases change internal pandas APIs.
    "pyjanitor==0.31.0",
    "pandas-flavor>=0.7,<0.8",
    "pyyaml>=6.0.2",
    "scikit-learn>=1.6.1",
    "seaborn>=0.13.2",
    "statsmodels>=0.15.0",
    "upsetplot>=0.9.0",
]

[dependency-groups]
dev = [
    "pytest>=8.2",
    "pytest-cov>=5.0",
    "ruff>=0.5",
]

[project.scripts]
{{ project_name | replace('_', '-') }} = "{{ project_name }}.main:main"

[tool.ruff]
extend-exclude = ["notebooks/aux_notebooks"]
extend-include = ["*.ipynb"]
line-length = 88
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["B", "E", "F", "I", "UP"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"

[tool.pytest.ini_options]
addopts = "--cov={{ project_name }} --cov-report=term-missing"
testpaths = ["tests"]

[tool.coverage.run]
source = ["{{ project_name }}"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_name }}"]
